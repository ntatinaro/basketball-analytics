[Unit]
Description=hoops: background worker
Requires=hoops-postgres.service
After=hoops-postgres.service

[Container]
ContainerName=hoops-worker
Image=localhost/hoops-backend:latest
Network=hoops.network
Volume=hoops-raw.volume:/data/raw
EnvironmentFile=%h/.config/hoops/hoops.env
Exec=worker

[Service]
Restart=always
# Podman before 5.0 ignores Notify=healthy on the database, so this can start before
# Postgres accepts connections; waiting between restarts keeps systemd retrying.
RestartSec=5
# Off while deploy/setup.sh runs (even after a reboot): nothing is predicted or locked
# before the models are chosen.
ExecCondition=/bin/sh -c '! test -f %h/.config/hoops/setup-in-progress'
# Heavy jobs (model fitting) must never slow the website.
Nice=10
CPUWeight=50
# Model fitting peaks at 1 to 2 GB; never let it squeeze the VPS's other services.
MemoryHigh=2G
MemoryMax=2500M

[Install]
WantedBy=default.target
