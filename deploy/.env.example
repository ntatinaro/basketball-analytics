# Copy to deploy/.env on the VPS and fill in. Never commit deploy/.env.

# Postgres connection used by the API and the worker.
HOOPS_DATABASE_URL=postgresql://hoops:CHANGE_ME@hoops-postgres:5432/hoops

# Password for the Postgres container: the same password as in the URL above, but raw
# here and URL-encoded there (for example @ becomes %40). Only read when the database
# is first created; changing it later needs ALTER USER inside Postgres as well.
POSTGRES_PASSWORD=CHANGE_ME

# Where raw ESPN responses are stored (inside the containers).
HOOPS_RAW_DIR=/data/raw

# DEBUG, INFO, WARNING, or ERROR.
HOOPS_LOG_LEVEL=INFO

# Leagues the worker updates, comma-separated: nba (V1), nba,ncaam (from V4).
HOOPS_LEAGUES=nba

# Dress rehearsal: 1 makes preseason games get predictions for testing only.
# They never appear in public grading. Set back to 0 before launch.
HOOPS_REHEARSAL=0

# Admin panel (V1.1): the owner's password, and a long random secret that signs admin
# sessions (for example from: openssl rand -hex 32). Leave the password empty to switch
# the admin panel off.
HOOPS_ADMIN_PASSWORD=
HOOPS_SECRET_KEY=
