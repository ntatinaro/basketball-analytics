# Backend image: API, worker, and command-line tools (hoops migrate, hoops backfill, ...).
FROM docker.io/library/python:3.13-slim-trixie
LABEL org.hoops.app=hoops

COPY --from=ghcr.io/astral-sh/uv:0.8 /uv /usr/local/bin/uv
ENV UV_COMPILE_BYTECODE=1 UV_LINK_MODE=copy UV_PROJECT_ENVIRONMENT=/opt/venv \
    PATH="/opt/venv/bin:$PATH" PYTHONUNBUFFERED=1

WORKDIR /app
COPY backend/pyproject.toml backend/uv.lock ./
RUN uv sync --frozen --no-dev --no-install-project
COPY backend/hoops ./hoops
RUN uv sync --frozen --no-dev

RUN useradd --uid 10001 --no-create-home --shell /usr/sbin/nologin hoops && mkdir -p /data/raw && chown hoops /data/raw
USER hoops
ENTRYPOINT ["hoops"]
